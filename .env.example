# Nebius Token Factory / AI Studio API key
NEBIUS_API_KEY=

# Nebius API base URL
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1

# Model id for Nemotron 3 Nano Omni on Nebius
NEMOTRON_MODEL_ID=nvidia/Nemotron-3-Nano-Omni

# Directory watched for the file-sorting demo scenario (defaults to ~/Downloads)
HEYPEER_WATCHED_DIR=

# Wake-word detection threshold, 0-1 (default 0.9 — see train.py's module
# docstring for why not the usual 0.5)
HEYPEER_WAKEWORD_THRESHOLD=

# TEMPORARY: prints a live mic dB meter + detection score while listening, and
# the input device name at startup — set to 0 once "Hey Peer" reliably
# triggers (default: on, i.e. "1")
HEYPEER_WAKEWORD_DEBUG=

# Spotify *application* credentials, from a free app registered at
# developer.spotify.com. These authorise search and nothing else: the
# client-credentials flow has no user, so there is no login prompt, no Premium
# requirement, and no access to anything of yours.
#
# Optional. Without them "lance X par Y" opens the search results in the app
# instead of playing the track, and Hey Peer says so rather than pretending.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Voice used for Hey Peer's spoken replies. Run `python -m heypeer.tray.tts
# --demo` to render every French voice to data/tts_demo/ and pick by ear.
# (upmc ships two speakers: 0 = jessica, 1 = pierre)
HEYPEER_TTS_VOICE=
HEYPEER_TTS_SPEAKER=
