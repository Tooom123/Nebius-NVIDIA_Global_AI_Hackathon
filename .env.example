# Nebius Token Factory / AI Studio API key
NEBIUS_API_KEY=

# Nebius API base URL
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1

# Model id for Nemotron 3 Nano Omni on Nebius
NEMOTRON_MODEL_ID=nvidia/Nemotron-3-Nano-Omni

# Directory watched for the file-sorting demo scenario (defaults to ~/Downloads)
HEYPEER_WATCHED_DIR=

# Wake-word detection threshold, 0-1 (default 0.9 — see train.py's module
# docstring for why not the usual 0.5)
HEYPEER_WAKEWORD_THRESHOLD=

# TEMPORARY: prints a live mic dB meter + detection score while listening, and
# the input device name at startup — set to 0 once "Hey Peer" reliably
# triggers (default: on, i.e. "1")
HEYPEER_WAKEWORD_DEBUG=
